  "pe-list": {
    "scope": "javascript,javascriptreact,css",
    "prefix": "pe-list",
    "description": "page/XxxList.jsx: lọc + bảng + phân trang + xoá",
    "body": [
      "import { useEffect, useState } from \"react\";",
      "import { Alert, Badge, Button, Col, Form, Row, Table } from \"react-bootstrap\";",
      "import { Link, useNavigate } from \"react-router-dom\";",
      "import { delete${1:Movie}, get${2:Movies} } from \"../api/${3:movie}\";",
      "import { get${4:Genres} } from \"../api/${5:genres}\";",
      "import { MS05, MS06, MS08 } from \"../../messages\";",
      "import Delete${1}Modal from \"../components/Delete${1}Modal\";",
      "import Pagination from \"../components/Pagination\";",
      "import { GENRE_COLOR, STATUS_COLOR } from \"../utils/badgeColors\";",
      "",
      "const SIZE = 5; // SỬA: số dòng mỗi trang",
      "",
      "// ===== SỬA: CỘT BẢNG — [tiêu đề, giá trị]. Cột # và Action có sẵn =====",
      "const COLUMNS = [",
      "  [\"Title\", (r) => r.title],",
      "  [\"Genre\", (r) => <Badge bg={GENRE_COLOR[r.genre?.name] || \"secondary\"}>{r.genre?.name}</Badge>],",
      "  [\"Duration\", (r) => r.duration + \"'\"],",
      "  [\"Price (đ)\", (r) => r.ticketPrice?.toLocaleString(\"vi-VN\")],",
      "  [\"Release\", (r) => r.releaseDate],",
      "  [\"Status\", (r) => <Badge bg={STATUS_COLOR[r.status] || \"secondary\"}>{r.status}</Badge>],",
      "];",
      "",
      "export default function ${1}List() {",
      "  const navigate = useNavigate();",
      "  const [list, setList] = useState([]); // các dòng của trang hiện tại",
      "  const [${5}, set${4}] = useState([]); // dữ liệu dropdown",
      "  const [keyword, setKeyword] = useState(\"\"); // ô nhập tên",
      "  const [${6:genreId}, set${7:GenreId}] = useState(\"\"); // dropdown đang chọn",
      "  const [page, setPage] = useState(0); // BE đếm từ 0",
      "  const [totalPages, setTotalPages] = useState(0);",
      "  const [total, setTotal] = useState(0);",
      "  const [deleteItem, setDeleteItem] = useState(null); // dòng đang hỏi xoá",
      "  const [msg, setMsg] = useState(\"\"); // thông báo xanh",
      "  const [error, setError] = useState(\"\"); // thông báo đỏ",
      "",
      "  async function load(p) {",
      "    try {",
      "      const data = await get${2}({",
      "        // SỬA: tên bên trái = @RequestParam của BE",
      "        ${8:title}: keyword.trim() || null,",
      "        ${6}: ${6} || null,",
      "        page: p,",
      "        size: SIZE,",
      "      });",
      "      setList(data.content);",
      "      setTotalPages(data.totalPages);",
      "      setTotal(data.totalElements);",
      "      setPage(p);",
      "      setError(\"\");",
      "    } catch {",
      "      setError(MS06);",
      "    }",
      "  }",
      "",
      "  useEffect(() => {",
      "    load(0);",
      "    get${4}().then(set${4}).catch(() => setError(MS06));",
      "  }, []);",
      "",
      "  async function handleDelete() {",
      "    try {",
      "      await delete${1}(deleteItem.id); // 204",
      "      setDeleteItem(null);",
      "      setMsg(MS08);",
      "      load(list.length === 1 && page > 0 ? page - 1 : page);",
      "    } catch {",
      "      setDeleteItem(null);",
      "      setError(MS06); // 404 / 500",
      "    }",
      "  }",
      "",
      "  return (",
      "    <>",
      "      <h6 className=\"page-title\">${1} List</h6>",
      "      {msg && <Alert variant=\"success\" className=\"py-2\">{msg}</Alert>}",
      "      {error && <Alert variant=\"danger\" className=\"py-2\">{error}</Alert>}",
      "",
      "      {/* SỬA: nhãn ô lọc + field dropdown (o.id, o.name) */}",
      "      <Row className=\"align-items-end g-3 mb-3\">",
      "        <Col md={3}>",
      "          <Form.Label className=\"small mb-1\">${9:Movie Title}</Form.Label>",
      "          <Form.Control size=\"sm\" maxLength={100} value={keyword} onChange={(e) => setKeyword(e.target.value)} />",
      "        </Col>",
      "        <Col md={3}>",
      "          <Form.Label className=\"small mb-1\">${10:Genre}</Form.Label>",
      "          <Form.Select size=\"sm\" value={${6}} onChange={(e) => set${7}(e.target.value)}>",
      "            <option value=\"\">-- All --</option>",
      "            {${5}.map((o) => (",
      "              <option key={o.id} value={o.id}>{o.name}</option>",
      "            ))}",
      "          </Form.Select>",
      "        </Col>",
      "        <Col xs=\"auto\">",
      "          <Button size=\"sm\" className=\"btn-main px-3\" onClick={() => { setMsg(\"\"); load(0); }}>Search</Button>",
      "        </Col>",
      "        <Col className=\"text-end\">",
      "          <Button size=\"sm\" className=\"btn-light-box\" onClick={() => navigate(\"/add\")}>+ Add New</Button>",
      "        </Col>",
      "      </Row>",
      "",
      "      <Table size=\"sm\" hover responsive className=\"table-head align-middle\">",
      "        <thead>",
      "          <tr>",
      "            <th>#</th>",
      "            {COLUMNS.map(([title]) => <th key={title}>{title}</th>)}",
      "            <th>Action</th>",
      "          </tr>",
      "        </thead>",
      "        <tbody>",
      "          {list.length === 0 && !error && (",
      "            <tr><td colSpan={COLUMNS.length + 2} className=\"text-center text-muted\">{MS05}</td></tr>",
      "          )}",
      "          {list.map((r, i) => (",
      "            <tr key={r.id}>",
      "              <td>{page * SIZE + i + 1}</td>",
      "              {COLUMNS.map(([title, value]) => <td key={title}>{value(r)}</td>)}",
      "              <td>",
      "                <Link to={\"/view/\" + r.id} className=\"text-decoration-none\">View</Link>",
      "                <span className=\"text-muted mx-2\">|</span>",
      "                <a href=\"#\" className=\"text-decoration-none text-danger\" onClick={(e) => { e.preventDefault(); setMsg(\"\"); setDeleteItem(r); }}>Delete</a>",
      "              </td>",
      "            </tr>",
      "          ))}",
      "        </tbody>",
      "      </Table>",
      "",
      "      <Pagination page={page} totalPages={totalPages} total={total} onChange={load} />",
      "      <Delete${1}Modal item={deleteItem} onYes={handleDelete} onClose={() => setDeleteItem(null)} />",
      "    </>",
      "  );",
      "}"
    ]
  },
  "pe-view": {
    "scope": "javascript,javascriptreact,css",
    "prefix": "pe-view",
    "description": "page/ViewXxx.jsx: xem chi tiết + Back",
    "body": [
      "import { useEffect, useState } from \"react\";",
      "import { Alert, Badge, Button, Table } from \"react-bootstrap\";",
      "import { useNavigate, useParams } from \"react-router-dom\";",
      "import { get${1:Movie}ById } from \"../api/${2:movie}\";",
      "import { MS06 } from \"../../messages\";",
      "import { GENRE_COLOR, STATUS_COLOR } from \"../utils/badgeColors\";",
      "",
      "// ===== SỬA: CÁC DÒNG CHI TIẾT — [nhãn, giá trị]. Tên field xem dto/XxxResponse.java =====",
      "const ROWS = [",
      "  [\"Movie Title\", (m) => m.title],",
      "  [\"Genre\", (m) => <Badge bg={GENRE_COLOR[m.genre?.name] || \"secondary\"}>{m.genre?.name}</Badge>],",
      "  [\"Director\", (m) => m.director],",
      "  [\"Duration (min)\", (m) => m.duration],",
      "  [\"Ticket Price (đ)\", (m) => m.ticketPrice?.toLocaleString(\"vi-VN\")],",
      "  [\"Release Date\", (m) => m.releaseDate],",
      "  [\"Age Rating\", (m) => m.ageRating],",
      "  [\"Language\", (m) => m.language],",
      "  [\"Status\", (m) => <Badge bg={STATUS_COLOR[m.status] || \"secondary\"}>{m.status}</Badge>],",
      "];",
      "",
      "export default function View${1}() {",
      "  const { id } = useParams(); // id trên đường dẫn /view/:id",
      "  const navigate = useNavigate();",
      "  const [item, setItem] = useState(null);",
      "  const [error, setError] = useState(\"\");",
      "",
      "  useEffect(() => {",
      "    get${1}ById(id).then(setItem).catch(() => setError(MS06)); // 404 / 500",
      "  }, [id]);",
      "",
      "  return (",
      "    <>",
      "      <h6 className=\"page-title\">${1} Details</h6>",
      "      {error && <Alert variant=\"danger\" className=\"py-2\">{error}</Alert>}",
      "      {item && (",
      "        <Table className=\"mt-2\">",
      "          <tbody>",
      "            {ROWS.map(([label, value]) => (",
      "              <tr key={label}>",
      "                <td className=\"text-muted fw-semibold\" style={{ width: \"25%\" }}>{label}</td>",
      "                <td>{value(item)}</td>",
      "              </tr>",
      "            ))}",
      "          </tbody>",
      "        </Table>",
      "      )}",
      "      <Button size=\"sm\" className=\"btn-light-box mt-2\" onClick={() => navigate(\"/\")}>← Back</Button>",
      "    </>",
      "  );",
      "}"
    ]
  },
  "pe-rules": {
    "scope": "javascript,javascriptreact,css",
    "prefix": "pe-rules",
    "description": "utils/xxxValidation.js: bảng ô nhập + validate",
    "body": [
      "import { MS01, MS02, MS03, MS07 } from \"../../messages\";",
      "",
      "// ===================================================================",
      "// SỬA: CHÉP TỪ BẢNG \"Screen Definition\" CỦA ĐỀ — mỗi dòng = 1 ô nhập",
      "//   name      = field BE nhận (dto/XxxRequest.java)",
      "//   label     = nhãn trên form ; errorName = tên trong câu lỗi (bỏ trống = dùng label)",
      "//   required  = Mandatory Yes ; max = Length",
      "//   number    = gửi lên BE dạng số ; min/maxValue = khoảng số",
      "//   type      = \"text\" | \"select\" | \"date\" | \"textarea\"",
      "//   server    = dropdown lấy từ API ; options = dropdown cố định (\"One of: ...\")",
      "//   notPast   = ngày >= hôm nay ; future = ngày > hôm nay",
      "//   col       = độ rộng 1..12 (6 = nửa dòng, 12 = cả dòng)",
      "// Đề không có ô nào thì XOÁ dòng đó, có thêm ô thì THÊM 1 dòng",
      "// ===================================================================",
      "export const FIELDS = [",
      "  { name: \"title\",       label: \"Movie Title\",      required: true, max: 150, col: 12, placeholder: \"Enter movie title\" },",
      "  { name: \"genreId\",     label: \"Genre\",            required: true, number: true, type: \"select\", server: true },",
      "  { name: \"director\",    label: \"Director\",         required: true, max: 100 },",
      "  { name: \"duration\",    label: \"Duration (min)\",   errorName: \"Duration\",     required: true, number: true, max: 3, min: 30, maxValue: 300 },",
      "  { name: \"ticketPrice\", label: \"Ticket Price (đ)\", errorName: \"Ticket Price\", required: true, number: true, max: 8, min: 30000, maxValue: 500000 },",
      "  { name: \"ageRating\",   label: \"Age Rating\",       required: true, type: \"select\", options: [\"P\", \"C13\", \"C16\", \"C18\"] },",
      "  { name: \"language\",    label: \"Language\",         required: true, max: 50 },",
      "  { name: \"releaseDate\", label: \"Release Date\",     required: true, type: \"date\", notPast: true },",
      "];",
      "",
      "// ===== Không cần sửa bên dưới =====",
      "",
      "export const EMPTY_FORM = Object.fromEntries(FIELDS.map((f) => [f.name, \"\"]));",
      "",
      "// Trả về { field: \"câu lỗi\" }. Rỗng = hợp lệ",
      "export function validateForm(form) {",
      "  const errors = {};",
      "  const today = new Date().toLocaleDateString(\"en-CA\"); // yyyy-MM-dd",
      "",
      "  for (const f of FIELDS) {",
      "    const name = f.errorName || f.label;",
      "    const v = String(form[f.name] ?? \"\").trim();",
      "",
      "    if (!v) {",
      "      if (f.required) errors[f.name] = MS01(name);",
      "      continue;",
      "    }",
      "    if (f.max && f.type !== \"date\" && v.length > f.max) {",
      "      errors[f.name] = name + \" must be at most \" + f.max + \" characters.\";",
      "    }",
      "    if (f.number && f.min != null && f.maxValue != null) {",
      "      const n = Number(v);",
      "      if (!/^\\d+$/.test(v) || n < f.min || n > f.maxValue) {",
      "        errors[f.name] = MS02(name, f.min.toLocaleString(\"en-US\"), f.maxValue.toLocaleString(\"en-US\"));",
      "      }",
      "    }",
      "    if (f.type === \"date\") {",
      "      if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(v)) errors[f.name] = MS03;",
      "      else if (f.notPast && v < today) errors[f.name] = MS07;",
      "      else if (f.future && v <= today) errors[f.name] = MS07;",
      "    }",
      "  }",
      "  return errors;",
      "}",
      "",
      "// Dữ liệu gửi BE: bỏ dấu cách 2 đầu, ô số đổi sang Number",
      "export function toRequest(form) {",
      "  return Object.fromEntries(",
      "    FIELDS.map((f) => {",
      "      const v = String(form[f.name] ?? \"\").trim();",
      "      return [f.name, f.number ? Number(v) : v];",
      "    })",
      "  );",
      "}"
    ]
  },
  "pe-add": {
    "scope": "javascript,javascriptreact,css",
    "prefix": "pe-add",
    "description": "page/AddXxx.jsx: form vẽ theo FIELDS + bắt lỗi 400/404/500",
    "body": [
      "import { useEffect, useState } from \"react\";",
      "import { Alert, Button, Col, Form, Row } from \"react-bootstrap\";",
      "import { useNavigate } from \"react-router-dom\";",
      "import { create${1:Movie} } from \"../api/${2:movie}\";",
      "import { get${3:Genres} } from \"../api/${4:genres}\";",
      "import { MS03, MS04, MS06, MS09 } from \"../../messages\";",
      "import { EMPTY_FORM, FIELDS, toRequest, validateForm } from \"../utils/${2}Validation\";",
      "",
      "export default function Add${1}() {",
      "  const navigate = useNavigate();",
      "  const [form, setForm] = useState(EMPTY_FORM);",
      "  const [${4}, set${3}] = useState([]); // dropdown lấy từ server",
      "  const [errors, setErrors] = useState({}); // lỗi đỏ dưới từng ô",
      "  const [msg, setMsg] = useState(\"\"); // MS04 xanh",
      "  const [error, setError] = useState(\"\"); // MS06 đỏ",
      "",
      "  useEffect(() => {",
      "    get${3}().then(set${3}).catch(() => setError(MS06));",
      "  }, []);",
      "",
      "  function handleChange(e) {",
      "    setForm({ ...form, [e.target.name]: e.target.value });",
      "  }",
      "",
      "  async function handleSave(e) {",
      "    e.preventDefault();",
      "    setMsg(\"\");",
      "    setError(\"\");",
      "    const errs = validateForm(form);",
      "    setErrors(errs);",
      "    if (Object.keys(errs).length > 0) return;",
      "",
      "    try {",
      "      await create${1}(toRequest(form)); // 200",
      "      setMsg(MS04);",
      "      setForm(EMPTY_FORM); // đề: xoá hết ô sau khi tạo thành công",
      "    } catch (err) {",
      "      const status = err.response?.status;",
      "      const body = err.response?.data;",
      "      if (status === 400 && body?.errors) {",
      "        // Validation failed: [{ field, message }] -> MS01/MS02/MS07 dưới ô",
      "        setErrors(Object.fromEntries(body.errors.map((x) => [x.field, x.message])));",
      "      } else if (status === 400 && body?.message?.includes(\"already exists\")) {",
      "        setErrors({ ${5:title}: MS09(\"${6:Movie Title}\") }); // trùng trong DB",
      "      } else if (status === 400) {",
      "        setErrors({ ${7:releaseDate}: MS03 }); // Malformed request body",
      "      } else {",
      "        setError(MS06); // 404 / 500 / mất kết nối",
      "      }",
      "    }",
      "  }",
      "",
      "  // Vẽ 1 ô theo cấu hình trong FIELDS",
      "  function renderInput(f) {",
      "    const props = { size: \"sm\", name: f.name, value: form[f.name], onChange: handleChange, isInvalid: !!errors[f.name] };",
      "    if (f.type === \"select\") {",
      "      // SỬA: field của dropdown server (o.id, o.name)",
      "      const opts = f.server ? ${4}.map((o) => [o.id, o.name]) : f.options.map((o) => [o, o]);",
      "      return (",
      "        <Form.Select {...props}>",
      "          <option value=\"\">-- Select --</option>",
      "          {opts.map(([value, text]) => <option key={value} value={value}>{text}</option>)}",
      "        </Form.Select>",
      "      );",
      "    }",
      "    if (f.type === \"date\") return <Form.Control type=\"date\" {...props} />;",
      "    if (f.type === \"textarea\") return <Form.Control as=\"textarea\" rows={3} maxLength={f.max} {...props} />;",
      "    return <Form.Control maxLength={f.max} placeholder={f.placeholder} {...props} />;",
      "  }",
      "",
      "  return (",
      "    <>",
      "      <h6 className=\"page-title\">Add New ${1}</h6>",
      "      {msg && <Alert variant=\"success\" className=\"py-2\">✓ {msg}</Alert>}",
      "      {error && <Alert variant=\"danger\" className=\"py-2\">{error}</Alert>}",
      "",
      "      <Form onSubmit={handleSave} noValidate>",
      "        <Row className=\"g-3 mb-3\">",
      "          {FIELDS.map((f) => (",
      "            <Col md={f.col || 6} key={f.name}>",
      "              <Form.Label className=\"small fw-semibold mb-1\">{f.label}{f.required && \" *\"}</Form.Label>",
      "              {renderInput(f)}",
      "              {errors[f.name] && <div className=\"text-danger small mt-1\">{errors[f.name]}</div>}",
      "            </Col>",
      "          ))}",
      "        </Row>",
      "        <Button type=\"submit\" size=\"sm\" className=\"btn-main px-3 me-3\">Save</Button>",
      "        <Button size=\"sm\" className=\"btn-light-box\" onClick={() => navigate(\"/\")}>Back</Button>",
      "      </Form>",
      "    </>",
      "  );",
      "}"
    ]
  },
